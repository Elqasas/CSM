# Copy to .env and adjust. Never commit .env.

DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset to use the local SQLite file (no database server needed).
# Production must point at PostgreSQL 16:
# DATABASE_URL=postgres://csm:csm@localhost:5432/csm

# All day-count scoring boundaries are evaluated in this timezone.
APP_TIME_ZONE=Africa/Cairo

# Email. The dev default prints to the console.
# EMAIL_URL=smtp://localhost:1025
DEFAULT_FROM_EMAIL=csm-platform@dphish.com

# Jira Service Management. Normally entered by an Admin on Settings ->
# Integrations instead; these apply only until that page is first saved.
# Setting all three syncs tickets from JSM and withdraws manual ticket entry.
# Create the token at https://id.atlassian.com/manage-profile/security/api-tokens
# JIRA_BASE_URL=https://dphish.atlassian.net
# JIRA_EMAIL=csm-integration@dphish.com
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEYS=SUP
# JIRA_BUG_ISSUE_TYPES=Bug
